{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          ".env",
          "config/**",
          "controllers/**",
          "models/**",
          "routes/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/contact/send",
      "dest": "/server.js"
    },
    {
      "src": "/api/chat/ask",
      "dest": "/server.js"
    },
    {
      "src": "/api/users(.*)",
      "dest": "/server.js"
    }
  ]
}